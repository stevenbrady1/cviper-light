{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CViper Light",
  "version": "0.1.0",
  "identifier": "com.cviper.light",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CViper Light",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMjlGQ0JDNkI0RjE1OEYKUldTUEZVOXJ2UHdwY0ZXcWJqRStBWklDSnZwS0Y4aFBFUVBPSTM3WHBzYzRuQUVPV3ExUXpvazYK",
      "endpoints": [
        "https://github.com/stevenbrady1/cviper-light/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
