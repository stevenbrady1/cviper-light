{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "sql:default",
    "sql:allow-execute",

    "store:default",

    "opener:default",

    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-open",
    "dialog:allow-save",

    "process:default",

    "updater:default"
  ]
}
