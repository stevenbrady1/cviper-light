{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "sql:allow-load",
    "sql:allow-close",

    "store:default",

    "opener:default",

    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "process:default"
  ]
}
