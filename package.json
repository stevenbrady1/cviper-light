{
  "name": "cviper",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tsc": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "cargo:check": "cargo check --manifest-path apps/light/src-tauri/Cargo.toml",
    "cargo:test": "cargo test --manifest-path apps/light/src-tauri/Cargo.toml",
    "build": "pnpm --filter @cviper/light build",
    "verify": "pnpm tsc && pnpm lint && pnpm test && pnpm cargo:check && pnpm cargo:test && pnpm build && pnpm format:check",
    "smoke": "node --test apps/light/e2e/smoke.spec.ts",
    "webkit:build": "pnpm --filter @cviper/light exec vite build --config vite.webkit-harness.config.ts && pnpm --filter @cviper/light exec vite build --config vite.contrast-harness.config.ts",
    "webkit": "pnpm webkit:build && node --test apps/light/e2e/pdfjs-webkit.spec.ts apps/light/e2e/contrast-webkit.spec.ts",
    "verify:updater-manifest": "node apps/light/src/release/verifyUpdaterManifest.ts",
    "check:l-numbers": "node apps/light/src/numbering/checkLNumbers.ts",
    "changelog:preview": "node apps/light/src/release/releaseChangelog.ts preview",
    "changelog:release": "node apps/light/src/release/releaseChangelog.ts release",
    "approved-sql": "vitest run apps/light/src/lib/approved-sql.contract.test.ts -u",
    "assets:msix": "node apps/light/src/packaging/generateMsixAssets.ts",
    "check:msix-manifest": "node apps/light/src/packaging/checkAppxManifestVersion.ts",
    "build:msix": "pnpm --filter @cviper/light exec tauri build --no-bundle --features microsoft-store --config src-tauri/tauri.microsoft-store.conf.json -- --no-default-features",
    "dev": "pnpm --filter @cviper/light tauri dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "2.11.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
